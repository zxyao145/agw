@host = http://localhost:5015

GET {{host}}/weatherforecast/
Accept: application/json

###


### ----------------------------
### Workflow domain examples
### ----------------------------

@agentId1 = 00000000-0000-0000-0000-000000000001
@agentId2 = 00000000-0000-0000-0000-000000000002
@workflowId = 00000000-0000-0000-0000-000000000010

### List workflows
GET {{host}}/api/workflows
Accept: application/json

###

### Create a Concurrent workflow (broadcast to all agents)
POST {{host}}/api/workflows
Content-Type: application/json
Accept: application/json

{
  "name": "demo-concurrent",
  "description": "Broadcast input to all agents and collect outputs.",
  "pattern": 0,
  "configurationJson": null,
  "enable": true,
  "agents": [
    { "agentId": "{{agentId1}}", "order": 0, "role": "analyzer" },
    { "agentId": "{{agentId2}}", "order": 1, "role": "reviewer" }
  ]
}

###

### Create a Sequential workflow (pipeline; output of previous becomes input of next)
POST {{host}}/api/workflows
Content-Type: application/json
Accept: application/json

{
  "name": "demo-sequential",
  "description": "Pass output from agent to agent.",
  "pattern": 1,
  "configurationJson": null,
  "enable": true,
  "agents": [
    { "agentId": "{{agentId1}}", "order": 0, "role": "stage-1" },
    { "agentId": "{{agentId2}}", "order": 1, "role": "stage-2" }
  ]
}

###

### Get workflow
GET {{host}}/api/workflows/{{workflowId}}
Accept: application/json

###

### List workflow agents (bindings)
GET {{host}}/api/workflows/{{workflowId}}/agents
Accept: application/json

###

### Execute workflow (Concurrent/Sequential supported; others return NotImplemented=true)
POST {{host}}/api/workflows/{{workflowId}}/execute
Content-Type: application/json
Accept: application/json

{
  "input": "Hello workflow"
}

###


### ----------------------------
### Project / Task (DSystem.Api) examples
### ----------------------------

@projectId = 00000000-0000-0000-0000-000000000100
@taskId = 00000000-0000-0000-0000-000000000200
@workflowIdForTask = 00000000-0000-0000-0000-000000000010

### Create project
POST {{host}}/api/projects
Content-Type: application/json
Accept: application/json

{
  "name": "demo-project",
  "description": "A project groups ordered tasks.",
  "enable": true
}

###

### List projects
GET {{host}}/api/projects
Accept: application/json

###

### Create task (async; scheduler will execute it when it becomes the earliest Pending by UpdateTime)
POST {{host}}/api/projects/{{projectId}}/tasks
Content-Type: application/json
Accept: application/json

{
  "workflowId": "{{workflowIdForTask}}",
  "description": "summarize something",
  "input": "Please summarize: ..."
}

###

### List tasks in project (creation time desc)
GET {{host}}/api/projects/{{projectId}}/tasks
Accept: application/json

###

### Get task (status/result)
GET {{host}}/api/projects/{{projectId}}/tasks/{{taskId}}
Accept: application/json

###

### Reorder a pending task by setting UpdateTimeUtc (earlier = executed sooner)
POST {{host}}/api/projects/{{projectId}}/tasks/{{taskId}}/reorder
Content-Type: application/json
Accept: application/json

{
  "updateTimeUtc": "2025-01-01T00:00:00Z"
}

###

### Cancel a task (Pending/Running only)
POST {{host}}/api/projects/{{projectId}}/tasks/{{taskId}}/cancel
Accept: application/json

###
