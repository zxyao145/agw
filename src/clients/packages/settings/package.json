{
  "name": "@agw/settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/auth": "workspace:*",
    "@agw/components": "workspace:*"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "react": "catalog:"
  }
}
