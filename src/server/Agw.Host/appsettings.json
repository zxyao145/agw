{
  "AgwDataDir": "~/agw",
  "Auth": {
    "AllowedOrigins": [
      "agw://app",
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "ConversationHistory": {
    "Mode": "Interval",
    "FlushIntervalSeconds": 10,
    "MaxBufferedBytes": 16777216
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Execution": {
    "Distributed": {
      "WorkerPollingMilliseconds": 250,
      "MaxConcurrentExecutions": 4,
      "LeaseSeconds": 30,
      "LeaseRenewSeconds": 10,
      "EventStream": {
        "Provider": "Postgres",
        "ReadPollingMilliseconds": 250,
        "ReadBatchSize": 100,
        "WriteIntervalMilliseconds": 250,
        "WriteBatchSize": 100,
        "Redis": {
          "ConnectionString": "",
          "StreamTtlMinutes": 1440
        }
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Agw",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": ""
  },
  "Integrations": {
    "OAuth": {
      "PublicBaseUrl": "http://localhost:30816",
      "WebBaseUrl": "http://localhost:3001"
    }
  },
  "ReverseProxy":{
    "TrustedProxies":[
      "127.0.0.1",
      "172.16.0.0/12",
      "10.0.0.0/8"
    ]
  },
  "Agents:Shell:Backend": "local",
  
  
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [TraceId:{TraceId}] [SpanId:{SpanId}] [ThreadId:{ThreadId}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithOpenTelemetryTraceId",
      "WithOpenTelemetrySpanId"
    ]
  }
}
