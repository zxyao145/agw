{
  "name": "@agw/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop client for Agw",
  "author": "Agw",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:extension-sdk": "node scripts/build-extension-sdk.mjs",
    "build:renderer": "next build renderer --webpack && node scripts/check-theme-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p renderer/tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "next dev renderer --port 3000 --webpack",
    "lint": "oxlint -c ../.oxlintrc.json ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs",
    "format": "oxfmt -c ../.oxfmtrc.json ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs *.json *.cjs",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs *.json *.cjs",
    "test": "tsx --test \"src/**/*.test.ts\" \"renderer/src/**/*.test.ts\"",
    "test:images": "node scripts/test-images.mjs",
    "test:extension-network": "node scripts/test-extension-network.mjs",
    "test:extensions": "node scripts/test-extensions.mjs",
    "test:development-reload": "pnpm build:renderer && node scripts/test-development-reload.mjs",
    "package": "pnpm build && pnpm prepare:resources && electron-forge package",
    "make": "pnpm build && pnpm prepare:resources && electron-forge make",
    "release:build": "node scripts/build-release.mjs",
    "release:collect": "node scripts/collect-artifacts.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs"
  },
  "dependencies": {
    "chardet": "catalog:",
    "iconv-lite": "catalog:"
  },
  "devDependencies": {
    "@agw/agents": "workspace:*",
    "@agw/api": "workspace:*",
    "@agw/chat": "workspace:*",
    "@agw/chat-runtime": "workspace:*",
    "@agw/code-view": "workspace:*",
    "@agw/components": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/extension-sdk": "workspace:*",
    "@agw/integrations": "workspace:*",
    "@agw/jobs": "workspace:*",
    "@agw/observability": "workspace:*",
    "@agw/projects": "workspace:*",
    "@agw/projects-core": "workspace:*",
    "@agw/providers": "workspace:*",
    "@agw/settings": "workspace:*",
    "@agw/skills": "workspace:*",
    "@agw/test-harness": "workspace:*",
    "@agw/tools": "workspace:*",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@tailwindcss/postcss": "catalog:",
    "@types/css-tree": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/postcss-import": "catalog:",
    "@types/semver": "catalog:",
    "@types/ws": "catalog:",
    "@types/yauzl": "catalog:",
    "@types/yazl": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@xmldom/xmldom": "catalog:",
    "acorn": "catalog:",
    "acorn-walk": "catalog:",
    "ajv": "catalog:",
    "code-inspector-plugin": "catalog:",
    "css-tree": "catalog:",
    "data-urls": "catalog:",
    "dts-bundle-generator": "catalog:",
    "electron": "44.4.3",
    "electron-squirrel-startup": "1.0.1",
    "electron-winstaller": "5.4.4",
    "env-paths": "2.2.1",
    "esbuild": "catalog:",
    "eventsource-parser": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "catalog:",
    "marked": "catalog:",
    "mime-types": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "postcss": "catalog:",
    "postcss-import": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "semver": "catalog:",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "wabt": "catalog:",
    "ws": "catalog:",
    "yauzl": "catalog:",
    "yazl": "catalog:",
    "zod": "catalog:"
  },
  "productName": "Agw Desktop"
}
