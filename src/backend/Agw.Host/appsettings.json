{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=agw.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false"
  },
  "Jobs": {
    "Scheduler": {
      "PrefetchInterval": "00:01:00",
      "PrefetchWindow": "00:10:00",
      "DispatchRetryDelay": "00:00:30"
    },
    "Worker": {
      "RetryDelay": "00:00:30"
    },
    "WorkerPool": {
      "Mode": "SingleNode",
      "MaxConcurrentJobs": 4,
      "HeartbeatInterval": "00:00:10",
      "WorkerTimeout": "00:00:30",
      "QueuePollInterval": "00:00:00.200",
      "DispatchPollInterval": "00:00:00.200",
      "DispatchResultTtl": "00:10:00",
      "SchedulerLockTtl": "00:00:30",
      "SchedulerLockRetryDelay": "00:00:05",
      "SchedulerLockRenewInterval": "00:00:10"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "Agw",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [TraceId:{TraceId}] [SpanId:{SpanId}] [ThreadId:{ThreadId}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/application-.log",
                "rollingInterval": "Hour",
                "retainedFileCountLimit": 30,
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [TraceId:{TraceId}] [SpanId:{SpanId}] [ThreadId:{ThreadId}] {Message:lj}{NewLine}{Exception}",
                "shared": true,
                "flushToDiskInterval": "00:00:01"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithOpenTelemetryTraceId",
      "WithOpenTelemetrySpanId"
    ]
  },
  "SystemInitialization": {
    "IsInitialized": false,
    "ApiKey": null
  }
}
