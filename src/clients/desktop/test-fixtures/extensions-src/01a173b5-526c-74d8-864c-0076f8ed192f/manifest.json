{
  "manifestVersion": 1,
  "id": "01a173b5-526c-74d8-864c-0076f8ed192f",
  "name": "Busy",
  "version": "1.0.0",
  "description": "Extension integration test fixture whose background and main view can enter an infinite loop.",
  "background": "background.js",
  "contributes": {
    "commands": [{ "id": "spin", "title": "Spin forever" }],
    "ribbon": [{ "id": "open", "title": "Busy", "icon": "Puzzle", "action": { "type": "openMainView", "view": "app" } }],
    "mainViews": [{ "id": "app", "title": "Busy", "icon": "Puzzle", "entry": "index.html" }],
    "chat": {
      "composerActions": [
        { "id": "spin", "title": "Spin forever", "icon": "Loader", "action": { "type": "command", "command": "spin" } }
      ]
    }
  }
}
