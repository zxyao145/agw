<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Agw Server</title>
    <style>
        :root { color-scheme: light dark; --bg:#f5f6f8; --surface:#fff; --surface-2:#f8f9fb; --text:#17191d; --muted:#666c77; --line:#e4e7ec; --primary:#006fee; --shadow:0 18px 55px rgba(20,28,43,.12); }
        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body { display:grid; place-items:center; padding:32px; font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:var(--text); background:radial-gradient(circle at 20% 0%,#eaf4ff 0,transparent 34%),var(--bg); margin:0; }
        .container { width:min(100%,720px); overflow:hidden; background:var(--surface); border:1px solid var(--line); border-radius:20px; box-shadow:var(--shadow); }
        .setup-header { display:flex; align-items:center; gap:10px; height:58px; padding:0 20px; border-bottom:1px solid var(--line); background:color-mix(in srgb,var(--surface) 92%,transparent); }
        .logo { display:grid; place-items:center; width:28px; height:28px; border-radius:9px; color:var(--surface); background:var(--text); font-size:12px; font-weight:700; }
        .setup-header strong { font-size:14px; }
        .setup-header span:last-child { margin-left:auto; color:var(--muted); font-size:11px; }
        .setup-body { padding:30px 34px 34px; }
        .eyebrow { margin:0 0 8px; color:var(--primary); font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
        h1 { margin:0; font-size:27px; letter-spacing:-.035em; }
        .lede { margin:8px 0 26px; color:var(--muted); font-size:14px; line-height:1.55; }
        .field { margin-bottom:18px; }
        .field label { display:block; margin-bottom:7px; font-size:13px; font-weight:600; }
        .field input, .field select { width:100%; height:42px; padding:0 12px; color:var(--text); background:var(--surface-2); border:1px solid var(--line); border-radius:10px; outline:none; font-size:14px; transition:border-color .15s,box-shadow .15s; }
        .field input:focus, .field select:focus { border-color:var(--primary); box-shadow:0 0 0 3px color-mix(in srgb,var(--primary) 16%,transparent); }
        .hint { margin-top:6px; color:var(--muted); font-size:11px; line-height:1.45; }
        .error { margin:0 0 16px; color:#e5484d; font-size:12px; }
        .button { width:100%; height:42px; margin-top:4px; color:#fff; background:var(--primary); border:0; border-radius:10px; cursor:pointer; font-weight:650; box-shadow:0 6px 18px color-mix(in srgb,var(--primary) 22%,transparent); }
        .button:hover { filter:brightness(.96); }
        .setup-note { display:flex; gap:9px; margin:8px 0 22px; padding:12px; color:var(--muted); background:var(--surface-2); border:1px solid var(--line); border-radius:11px; font-size:11px; line-height:1.45; }
        .setup-note b { color:var(--text); }
        @@media (prefers-color-scheme:dark) { :root { --bg:#0d0f12; --surface:#121418; --surface-2:#17191e; --text:#f3f4f6; --muted:#a0a6b0; --line:#272a31; --primary:#338ef7; --shadow:0 20px 60px rgba(0,0,0,.46); } body { background:radial-gradient(circle at 20% 0%,#102a45 0,transparent 35%),var(--bg); } }
        @@media (max-width:600px) { body { padding:14px; } .setup-body { padding:24px 20px 26px; } }
    </style>
</head>
<body>
    <div class="container">
        <header class="setup-header"><span class="logo">A</span><strong>Agw Server</strong><span>First-run setup</span></header>
        <main class="setup-body">@RenderBody()</main>
    </div>
</body>
</html>
