{
  "name": "@agw/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./math.css": "./src/math.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat-core": "workspace:*",
    "@agw/chat-runtime": "workspace:*",
    "@agw/components": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/projects": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "katex": "0.18.7",
    "react-markdown": "catalog:",
    "rehype-katex": "7.0.1",
    "remark-gfm": "catalog:",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*",
    "@types/jsdom": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  }
}
