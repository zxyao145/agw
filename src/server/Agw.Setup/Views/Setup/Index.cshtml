@model SetupRequest
@{
    ViewData["Title"] = "Set up Agw";
}

<p class="eyebrow">Server foundation</p>
<h1>Set up your Agw Server</h1>
<p class="lede">Choose the database and administrator credential for this Server. Desktop will reconnect automatically when setup completes.</p>

<div class="setup-note"><span>●</span><span><b>Stored locally.</b> Configuration, keys, logs, and the default SQLite database live under <code>~/agw</code>.</span></div>

<div asp-validation-summary="ModelOnly" class="error"></div>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="field">
        <label asp-for="Provider">Database provider</label>
        <select asp-for="Provider">
            <option value="sqlite">SQLite</option>
            <option value="postgres">PostgreSQL</option>
        </select>
        <div class="hint">SQLite is recommended for a local Desktop installation. Use PostgreSQL for a shared Server.</div>
    </div>

    <div class="field">
        <label asp-for="ConnectionString">Connection string</label>
        <input asp-for="ConnectionString" />
        <div class="hint">SQLite example: Data Source=agw.db. PostgreSQL requires a complete connection string.</div>
        <span asp-validation-for="ConnectionString" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="AdminPassword">Administrator password</label>
        <input asp-for="AdminPassword" type="password" autocomplete="new-password" />
        <div class="hint">Use at least 8 characters. This password authenticates browser administration sessions.</div>
        <span asp-validation-for="AdminPassword" class="error"></span>
    </div>

    @if (ViewData["RequireSetupCode"] as bool? == true)
    {
        <div class="field">
            <label asp-for="SetupCode"></label>
            <input asp-for="SetupCode" autocomplete="one-time-code" />
            <div class="hint">Enter the one-time Setup Code printed in the Server startup log.</div>
        </div>
    }

    <button type="submit" class="button">Initialize Server</button>
</form>
