{
  "name": "@agw/chat-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./composer": "./src/composer.tsx",
    "./conversation": "./src/conversation-history.tsx",
    "./execution": "./src/native-execution-session.ts",
    "./history": "./src/native-conversation-list.tsx",
    "./provider": "./src/native-chat-provider.tsx",
    "./targets": "./src/chat-targets.ts",
    "./workspace": "./src/native-workspace-provider.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat-core": "workspace:*",
    "@agw/chat-runtime": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/projects-core": "workspace:*",
    "lucide-react-native": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "expo-file-system": "catalog:",
    "expo-image": "catalog:",
    "expo-image-picker": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-enriched-markdown": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "expo-file-system": "catalog:",
    "expo-image": "catalog:",
    "expo-image-picker": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-enriched-markdown": "catalog:"
  }
}
