{
  "name": "@agw/execution-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  }
}
