@model SetupRequest
@{
    ViewData["Title"] = "系统初始化";
}

<h1>Agw 初始化向导</h1>
<p>首次运行需要先完成初始化。初始化完成前，所有 API 接口将不可访问。</p>

<div asp-validation-summary="ModelOnly" class="error"></div>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="field">
        <label asp-for="Provider"></label>
        <select asp-for="Provider">
            <option value="sqlite">SQLite</option>
            <option value="postgres">PostgreSQL</option>
        </select>
        <div class="hint">后续可扩展更多数据库类型。</div>
    </div>

    <div class="field">
        <label asp-for="ConnectionString"></label>
        <input asp-for="ConnectionString" />
        <div class="hint">示例：SQLite = Data Source=agw.db；PostgreSQL 请填写完整连接字符串。</div>
        <span asp-validation-for="ConnectionString" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="AdminPassword"></label>
        <input asp-for="AdminPassword" autocomplete="new-password" />
        <div class="hint">至少 12 个字符。远程访问时使用此密码登录管理界面。</div>
        <span asp-validation-for="AdminPassword" class="error"></span>
    </div>

    @if (ViewData["RequireSetupCode"] as bool? == true)
    {
        <div class="field">
            <label asp-for="SetupCode"></label>
            <input asp-for="SetupCode" autocomplete="one-time-code" />
            <div class="hint">输入 Server 启动日志中显示的一次性 Setup Code。</div>
        </div>
    }

    <button type="submit" class="button">初始化系统</button>
</form>
