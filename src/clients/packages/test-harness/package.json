{
  "name": "@agw/test-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint ./src",
    "format": "oxfmt ./src *.json",
    "format:check": "oxfmt --check ./src *.json"
  },
  "dependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "jsdom": "26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "typescript": "5.9.3"
  }
}
