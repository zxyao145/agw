{
  "name": "@agw/clients",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@agw/web",
    "dev:desktop": "cross-env AGW_RENDERER_URL=http://localhost:3000 turbo run dev:renderer --filter=@agw/desktop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "gen:api": "turbo run gen:api",
    "prepare:renderer": "turbo run prepare:renderer --filter=@agw/desktop",
    "package:desktop": "turbo run package --filter=@agw/desktop --",
    "make:desktop": "turbo run make --filter=@agw/desktop --",
    "release:collect": "turbo run release:collect --filter=@agw/desktop --"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "tailwindcss": "4.2.2",
    "turbo": "2.10.5",
    "tw-animate-css": "1.4.0"
  },
  "packageManager": "pnpm@11.7.0"
}
