{
  "name": "@agw/clients",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@agw/web",
    "dev:desktop": "turbo run dev --filter=@agw/desktop",
    "dev:mobile": "turbo run dev --filter=@agw/mobile",
    "android:mobile": "pnpm --filter=@agw/mobile android",
    "ios:mobile": "pnpm --filter=@agw/mobile ios",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm test:boundaries && turbo run test",
    "test:boundaries": "node tools/scripts/check-client-boundaries.mjs",
    "test:e2e": "turbo run test:e2e",
    "fmt": "turbo run format",
    "fmt:check": "turbo run format:check",
    "gen:api": "turbo run gen:api",
    "package:desktop": "turbo run package --filter=@agw/desktop --",
    "make:desktop": "turbo run make --filter=@agw/desktop --",
    "release:desktop": "pnpm --filter=@agw/desktop release:build",
    "release:collect": "turbo run release:collect --filter=@agw/desktop --"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "next": "16.2.1",
    "tailwindcss": "4.2.2",
    "turbo": "2.10.5",
    "tw-animate-css": "1.4.0"
  },
  "packageManager": "pnpm@11.7.0"
}
