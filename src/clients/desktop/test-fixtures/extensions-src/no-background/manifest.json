{
  "manifestVersion": 1,
  "id": "no-background",
  "name": "No Background",
  "version": "1.0.0",
  "description": "Extension integration test fixture with a main view, no background and execution sessions of its own.",
  "permissions": ["execution"],
  "contributes": {
    "ribbon": [
      { "id": "open", "title": "No Background", "icon": "Puzzle", "action": { "type": "openMainView", "view": "app" } }
    ],
    "mainViews": [{ "id": "app", "title": "No Background", "icon": "Puzzle", "entry": "index.html" }]
  }
}
