{
  "manifestVersion": 1,
  "id": "markdown-preview",
  "name": "Markdown Preview",
  "version": "1.0.0",
  "description": "Renders Markdown files in the Files view.",
  "author": "Agw",
  "contributes": {
    "fileViewers": [
      {
        "id": "preview",
        "title": "Preview",
        "icon": "BookOpen",
        "patterns": ["*.md", "*.markdown"],
        "entry": "index.html"
      }
    ]
  },
  "permissions": ["fs.cloud.read"]
}
