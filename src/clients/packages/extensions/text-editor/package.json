{
  "name": "@agw/extension-text-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Agw Desktop bundled extension that previews Markdown files and edits text files in the Files view",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../../.oxlintrc.json ./src ./vite.config.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../../.oxfmtrc.json ./src ./vite.config.ts *.json *.html",
    "format:check": "oxfmt -c ../../../.oxfmtrc.json --check ./src ./vite.config.ts *.json *.html"
  },
  "devDependencies": {
    "@agw/extension-sdk": "workspace:*",
    "@floating-ui/dom": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-bubble-menu": "catalog:",
    "@tiptap/extension-code-block": "catalog:",
    "@tiptap/extension-code-block-lowlight": "catalog:",
    "@tiptap/extension-collaboration": "catalog:",
    "@tiptap/extension-drag-handle": "catalog:",
    "@tiptap/extension-drag-handle-react": "catalog:",
    "@tiptap/extension-floating-menu": "catalog:",
    "@tiptap/extension-heading": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-node-range": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/static-renderer": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@tiptap/y-tiptap": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/mdast": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "diff": "catalog:",
    "fast-check": "catalog:",
    "github-slugger": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "highlight.js": "catalog:",
    "jsdom": "catalog:",
    "lowlight": "catalog:",
    "marked": "catalog:",
    "marked-footnote": "catalog:",
    "mdast-util-gfm": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "micromark-util-classify-character": "catalog:",
    "micromark-util-decode-string": "catalog:",
    "monaco-editor": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vfile": "catalog:",
    "vfile-matter": "catalog:",
    "vite": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  }
}
