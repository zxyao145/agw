{
  "name": "@agw/extension-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src ./browser-tests",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:browser": "tsx --test \"browser-tests/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src ./browser-tests *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src ./browser-tests *.json"
  },
  "dependencies": {
    "@agw/execution-types": "workspace:*"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:"
  }
}
