{
  "name": "@agw/projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src ./browser-tests",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:browser": "tsx --test browser-tests/*.test.ts",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src ./browser-tests *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src ./browser-tests *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/code-view": "workspace:*",
    "@agw/components": "workspace:*",
    "@agw/integrations": "workspace:*",
    "@agw/projects-core": "workspace:*",
    "@agw/tools": "workspace:*",
    "@tanstack/react-virtual": "catalog:"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/jsdom": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "sonner": "catalog:"
  }
}
