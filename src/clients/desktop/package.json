{
  "name": "@agw/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform desktop client for Agw",
  "author": "Agw",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "next build renderer --webpack",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "next dev renderer --port 3000 --webpack",
    "lint": "oxlint ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs",
    "format": "oxfmt ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs *.json *.cjs",
    "format:check": "oxfmt --check ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs *.json *.cjs",
    "fmt": "oxfmt ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs *.json *.cjs",
    "fmt:check": "oxfmt --check ./src ./scripts ./renderer/src ./renderer/*.ts ./renderer/*.mjs *.json *.cjs",
    "test": "tsx --test \"src/**/*.test.ts\" \"renderer/src/**/*.test.ts\"",
    "package": "pnpm build && pnpm prepare:resources && electron-forge package",
    "make": "pnpm build && pnpm prepare:resources && electron-forge make",
    "release:build": "node scripts/build-release.mjs",
    "release:collect": "node scripts/collect-artifacts.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@agw/agents": "workspace:*",
    "@agw/api": "workspace:*",
    "@agw/chat": "workspace:*",
    "@agw/components": "workspace:*",
    "@agw/integrations": "workspace:*",
    "@agw/jobs": "workspace:*",
    "@agw/observability": "workspace:*",
    "@agw/projects": "workspace:*",
    "@agw/providers": "workspace:*",
    "@agw/skills": "workspace:*",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "code-inspector-plugin": "2.0.3",
    "electron": "43.4.0",
    "electron-winstaller": "5.4.4",
    "lucide-react": "0.577.0",
    "next": "16.2.1",
    "next-themes": "0.4.6",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "2.0.7",
    "tailwindcss": "4.2.2",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "productName": "Agw Desktop"
}
