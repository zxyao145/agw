{
  "name": "@agw/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:generate": "expo prebuild",
    "build": "expo export --platform all --output-dir dist",
    "lint": "oxlint -c ../.oxlintrc.json app src tests",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt -c ../.oxfmtrc.json app src tests *.json *.ts *.js",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check app src tests *.json *.ts *.js"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat-native": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/projects-core": "workspace:*",
    "@babel/runtime": "8.0.5",
    "@expo-google-fonts/inter": "0.4.2",
    "@microsoft/signalr": "catalog:",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@tanstack/react-query": "catalog:",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "catalog:",
    "expo-font": "~57.0.4",
    "expo-image": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-enriched-markdown": "catalog:",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "catalog:",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
