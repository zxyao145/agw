{
  "name": "@agw/chat-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./activity": "./src/execution-activity-store.ts",
    "./controller": "./src/conversation-controller.ts",
    "./execution": "./src/execution.ts",
    "./execution-session": "./src/execution-session.ts",
    "./execution-session-manager": "./src/execution-session-manager.ts",
    "./execution-stream": "./src/execution-stream.ts",
    "./react": "./src/use-conversation-controller.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt ./src *.json",
    "format:check": "oxfmt --check ./src *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat-core": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@microsoft/signalr": "10.0.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "19.2.3"
  }
}
