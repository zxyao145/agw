{
  "name": "@agw/components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./query": "./src/ui-web/query.ts",
    "./ui-tokens.css": "./src/ui-tokens/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "radix-ui": "1.6.7",
    "react-day-picker": "10.0.1",
    "react-resizable-panels": "4.13.1",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "sonner": "catalog:"
  }
}
