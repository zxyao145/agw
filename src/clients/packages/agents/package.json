{
  "name": "@agw/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat": "workspace:*",
    "@agw/components": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/integrations": "workspace:*",
    "@agw/tools": "workspace:*",
    "elkjs": "0.12.0",
    "mermaid": "12.0.0",
    "reactflow": "11.11.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  }
}
