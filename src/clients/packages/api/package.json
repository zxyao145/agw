{
  "name": "@agw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src ./type-tests",
    "test": "pnpm test:types && tsx --test \"src/**/*.test.ts\"",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src ./type-tests *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src ./type-tests *.json",
    "gen:api": "openapi-typescript openapi.json -o src/openapi.d.ts"
  },
  "dependencies": {
    "@agw/http-client": "workspace:*",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
