log_format agw_no_query '$remote_addr - $remote_user [$time_local] '
                        '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                        '"$http_user_agent"';

server {
    listen 443 ssl http2;
    server_name agw.example.com;

    # SignalR 会在 WebSocket URL 中携带 Token，日志只记录路径，避免泄露查询参数。
    access_log /var/log/nginx/agw.access.log agw_no_query;

    location / {
        proxy_pass http://127.0.0.1:30816;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
