{
  "name": "@agw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint ./src ./type-tests",
    "test": "pnpm test:types && tsx --test \"src/**/*.test.ts\"",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "format": "oxfmt ./src ./type-tests *.json",
    "format:check": "oxfmt --check ./src ./type-tests *.json",
    "gen:api": "openapi-typescript ../../web/openapi.json -o src/openapi.d.ts"
  },
  "dependencies": {
    "@agw/http-client": "workspace:*",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
