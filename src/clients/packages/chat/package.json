{
  "name": "@agw/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./markdown-tiptap": "./src/ui-web/markdown-tiptap/index.ts",
    "./math.css": "./src/math.css",
    "./image-preview.css": "./src/image-preview.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src ./browser-tests",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:browser": "tsx --test browser-tests/*.test.ts",
    "test:server-images": "tsx --test browser-tests/conversation-image-files.integration.ts",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src ./browser-tests *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src ./browser-tests *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat-core": "workspace:*",
    "@agw/chat-runtime": "workspace:*",
    "@agw/components": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/projects": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-code-block": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-mathematics": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/static-renderer": "catalog:",
    "idb": "catalog:",
    "katex": "0.18.7",
    "marked": "catalog:",
    "marked-footnote": "catalog:",
    "micromark-util-decode-string": "catalog:",
    "react-markdown": "catalog:",
    "rehype-katex": "7.0.1",
    "remark-gfm": "catalog:",
    "remark-math": "6.0.0",
    "yet-another-react-lightbox": "catalog:"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*",
    "@types/jsdom": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  }
}
