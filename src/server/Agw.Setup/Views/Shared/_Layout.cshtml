<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Agw Server</title>
    <style>
        :root {
            color-scheme: light dark;
            --canvas: #e8e8e1;
            --surface: #f7f6ef;
            --surface-raised: #fffef9;
            --ink: #17201d;
            --muted: #66706b;
            --faint: #8b948f;
            --line: #cdd1ca;
            --line-strong: #9da69f;
            --accent: #e45a2b;
            --signal: #11765d;
            --danger: #b63b30;
            --shadow: 0 28px 80px rgba(34, 42, 38, .13);
            --font-display: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, serif;
            --font-body: "Avenir Next", "Segoe UI Variable", "Helvetica Neue", sans-serif;
            --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        }

        * { box-sizing: border-box; }
        html { min-height: 100%; }
        body {
            min-height: 100vh;
            margin: 0;
            padding: 44px 24px;
            color: var(--ink);
            background:
                linear-gradient(rgba(23, 32, 29, .035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(23, 32, 29, .035) 1px, transparent 1px),
                radial-gradient(circle at 12% 8%, rgba(228, 90, 43, .13), transparent 31%),
                var(--canvas);
            background-size: 32px 32px, 32px 32px, auto, auto;
            font-family: var(--font-body);
        }

        button, input, select { font: inherit; }
        .container {
            width: min(100%, 940px);
            margin: 0 auto;
            overflow: hidden;
            background: var(--surface);
            border: 1px solid var(--line-strong);
            border-radius: 8px;
            box-shadow: var(--shadow);
        }

        .setup-header {
            display: flex;
            align-items: center;
            min-height: 64px;
            padding: 0 26px;
            border-bottom: 1px solid var(--line);
            background: color-mix(in srgb, var(--surface-raised) 78%, transparent);
        }

        .brand { display: flex; align-items: center; gap: 12px; }
        .logo {
            display: grid;
            place-items: center;
            width: 31px;
            height: 31px;
            color: #fffdf7;
            background: var(--ink);
            border-radius: 3px;
            font-family: var(--font-display);
            font-size: 17px;
            font-style: italic;
            font-weight: 700;
        }

        .brand strong { font-family: var(--font-display); font-size: 17px; letter-spacing: -.015em; }
        .header-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
            color: var(--muted);
            font-family: var(--font-mono);
            font-size: 10px;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .header-status::before {
            width: 7px;
            height: 7px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 13%, transparent);
            content: "";
        }

        .setup-body { padding: 48px 52px 52px; }
        .page-intro { max-width: 680px; margin-bottom: 40px; }
        .eyebrow, .section-kicker {
            margin: 0 0 10px;
            color: var(--accent);
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        h1, h2, p { margin-top: 0; }
        h1 {
            max-width: 620px;
            margin-bottom: 12px;
            font-family: var(--font-display);
            font-size: clamp(37px, 5.3vw, 58px);
            font-weight: 500;
            letter-spacing: -.045em;
            line-height: .98;
        }

        .lede { max-width: 590px; margin-bottom: 0; color: var(--muted); font-size: 15px; line-height: 1.65; }
        .validation-banner:not(:empty) {
            margin: -16px 0 28px;
            padding: 13px 15px;
            color: var(--danger);
            background: color-mix(in srgb, var(--danger) 8%, var(--surface-raised));
            border: 1px solid color-mix(in srgb, var(--danger) 30%, var(--line));
            border-radius: 5px;
            font-size: 13px;
        }

        .validation-banner ul { margin: 0; padding-left: 18px; }
        .setup-wizard { position: relative; }
        .wizard-panel {
            padding: 30px 32px 34px;
            background: color-mix(in srgb, var(--surface-raised) 68%, var(--surface));
            border: 1px solid var(--line);
            border-radius: 6px;
        }

        .wizard-panel:not(.is-active), .wizard-panel[hidden] { display: none; }
        .wizard-panel.is-active { animation: panel-enter .24s ease both; }
        .wizard-panel:focus { outline: none; }
        .wizard-heading { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(220px, .9fr); gap: 24px; margin-bottom: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
        .section-kicker { margin-bottom: 5px; color: var(--signal); }
        .wizard-heading h2 { margin-bottom: 0; font-family: var(--font-display); font-size: 29px; font-weight: 600; letter-spacing: -.025em; }
        .wizard-heading > p { align-self: end; margin-bottom: 2px; color: var(--muted); font-size: 12px; line-height: 1.55; }
        @@keyframes panel-enter {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .field { min-width: 0; }
        .administrator-fields { max-width: 580px; }
        .field--setup-code { margin-top: 18px; padding-top: 18px; border-top: 1px dashed var(--line-strong); }
        .field label { display: block; margin-bottom: 7px; font-size: 11px; font-weight: 700; letter-spacing: .01em; }
        .field input {
            width: 100%;
            height: 44px;
            padding: 0 12px;
            color: var(--ink);
            background: var(--surface-raised);
            border: 1px solid var(--line-strong);
            border-radius: 4px;
            outline: none;
            font-size: 13px;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .field input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent); }
        .field input::placeholder { color: var(--faint); }
        .hint { margin: 6px 0 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
        .field-error { display: block; min-height: 0; margin-top: 5px; color: var(--danger); font-size: 10px; line-height: 1.35; }
        .field-error:empty { display: none; }
        .form-action { display: flex; align-items: center; justify-content: flex-end; gap: 24px; padding-top: 22px; }
        .wizard-actions { display: flex; gap: 10px; }
        .button {
            display: inline-flex;
            min-width: 218px;
            height: 48px;
            padding: 0 18px;
            align-items: center;
            justify-content: space-between;
            gap: 26px;
            color: #fffdf7;
            background: var(--ink);
            border: 1px solid var(--ink);
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
        }

        .button:hover { background: var(--accent); border-color: var(--accent); box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 25%, transparent); transform: translateY(-1px); }
        .button:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 30%, transparent); outline-offset: 3px; }
        .button:disabled { cursor: wait; opacity: .65; transform: none; }
        [hidden] { display: none !important; }

        @@media (prefers-color-scheme: dark) {
            :root {
                --canvas: #111713;
                --surface: #18201c;
                --surface-raised: #1f2823;
                --ink: #eef1e9;
                --muted: #a8b0aa;
                --faint: #7f8982;
                --line: #313b35;
                --line-strong: #526057;
                --accent: #f27848;
                --signal: #62c9aa;
                --danger: #ff8c81;
                --shadow: 0 30px 90px rgba(0, 0, 0, .42);
            }

            body { background-image: linear-gradient(rgba(238, 241, 233, .025) 1px, transparent 1px), linear-gradient(90deg, rgba(238, 241, 233, .025) 1px, transparent 1px), radial-gradient(circle at 12% 8%, rgba(242, 120, 72, .12), transparent 31%); }
            .logo, .button { color: #17201d; background: #eef1e9; }
            .button { border-color: #eef1e9; }
            .button:hover { color: #fffdf7; background: var(--accent); border-color: var(--accent); }
        }

        @@media (max-width: 720px) {
            body { padding: 14px; background-size: 24px 24px, 24px 24px, auto, auto; }
            .setup-header { min-height: 58px; padding: 0 18px; }
            .header-status { font-size: 8px; }
            .setup-body { padding: 32px 22px 30px; }
            .page-intro { margin-bottom: 30px; }
            h1 { font-size: clamp(35px, 12vw, 48px); }
            .wizard-panel { min-height: 0; padding: 24px; }
            .wizard-heading { grid-template-columns: 1fr; gap: 8px; }
            .wizard-heading > p { max-width: 420px; }
            .form-action { align-items: stretch; flex-direction: column; }
            .wizard-actions { width: 100%; }
            .wizard-actions .button { min-width: 0; flex: 1; }
        }

        @@media (max-width: 430px) {
            .header-status span { display: none; }
            .setup-body { padding-inline: 17px; }
            .wizard-panel { padding: 20px 17px 22px; }
            .wizard-actions { gap: 8px; }
            .button { padding-inline: 14px; gap: 12px; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="setup-header">
            <div class="brand"><span class="logo">A</span><strong>Agw Server</strong></div>
            <div class="header-status"><span>First-run control plane</span></div>
        </header>
        <main class="setup-body">@RenderBody()</main>
    </div>
</body>
</html>
