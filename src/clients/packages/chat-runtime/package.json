{
  "name": "@agw/chat-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./activity": "./src/execution-activity-store.ts",
    "./chat-http-client": "./src/chat-http-client.ts",
    "./controller": "./src/conversation-controller.ts",
    "./execution": "./src/execution.ts",
    "./execution-session": "./src/execution-session.ts",
    "./execution-session-manager": "./src/execution-session-manager.ts",
    "./execution-stream": "./src/execution-stream.ts",
    "./react": "./src/use-conversation-controller.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "format": "oxfmt -c ../../.oxfmtrc.json ./src *.json",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check ./src *.json"
  },
  "dependencies": {
    "@agw/api": "workspace:*",
    "@agw/chat-core": "workspace:*",
    "@agw/execution-core": "workspace:*",
    "@agw/projects-core": "workspace:*",
    "@microsoft/signalr": "catalog:"
  },
  "devDependencies": {
    "@agw/test-harness": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
