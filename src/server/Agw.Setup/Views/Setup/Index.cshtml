@model SetupRequest
@{
    ViewData["Title"] = "Set up Agw";
}

<div class="page-intro">
    <p class="eyebrow">Welcome to Agw</p>
    <h1>Secure your Server.</h1>
    <p class="lede">Create an administrator password to start using Agw.</p>
</div>

<div asp-validation-summary="ModelOnly" class="validation-banner" role="alert"></div>

<form method="post" id="setup-form" class="setup-wizard">
    @Html.AntiForgeryToken()

    <section class="wizard-panel is-active" aria-labelledby="administrator-heading">
        <div class="wizard-heading">
            <div>
                <p class="section-kicker">Administrator access</p>
                <h2 id="administrator-heading">Set your password</h2>
            </div>
            <p>You will use this password to sign in to the management console.</p>
        </div>

        <div class="administrator-fields">
            <div class="field">
                <label asp-for="AdminPassword"></label>
                <input asp-for="AdminPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required autofocus />
                <p class="hint">Use 8–256 characters.</p>
                <span asp-validation-for="AdminPassword" class="field-error"></span>
            </div>

            @if (ViewData["RequireSetupCode"] as bool? == true)
            {
                <div class="field field--setup-code">
                    <label asp-for="SetupCode"></label>
                    <input asp-for="SetupCode" autocomplete="one-time-code" spellcheck="false" required />
                    <p class="hint">Enter the one-time code printed in the Server startup log.</p>
                    <span asp-validation-for="SetupCode" class="field-error"></span>
                </div>
            }
        </div>
    </section>

    <div class="form-action">
        <div class="wizard-actions">
            <button type="submit" class="button">
                <span>Initialize Server</span>
                <span aria-hidden="true">→</span>
            </button>
        </div>
    </div>
</form>

<script>
    (() => {
        const form = document.getElementById("setup-form");
        form.addEventListener("submit", () => {
            const button = form.querySelector('button[type="submit"]');
            button.disabled = true;
            button.firstElementChild.textContent = "Initializing…";
            form.setAttribute("aria-busy", "true");
        });
    })();
</script>
